{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["js/*"]
    },
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
